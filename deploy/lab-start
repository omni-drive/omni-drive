#!/usr/bin/env bash

set -euo pipefail

LAB_WORKSPACE="/home/guest/lab"
MASTER_TEMPLATE="{{PROJECT_ROOT}}/lab/notebook.ipynb"

echo "=================================================="
echo "   OmniDrive Lab - Inicjalizacja stanowiska"
echo "=================================================="

if [ ! -f "$MASTER_TEMPLATE" ]; then
  echo "Błąd: Nie znaleziono wzorcowego szablonu w $MASTER_TEMPLATE"
  exit 1
fi

mkdir -p "$LAB_WORKSPACE"

TIMESTAMP="$(date +'%m%d%H%M%S')"
TARGET_NOTEBOOK="lab_${TIMESTAMP}.ipynb"

echo "Tworzenie nowego pliku notebooka:"
echo "  -> $TARGET_NOTEBOOK"

cp "$MASTER_TEMPLATE" "$LAB_WORKSPACE/$TARGET_NOTEBOOK"
chmod 664 "$LAB_WORKSPACE/$TARGET_NOTEBOOK"

echo ""
echo "Gotowe! Utworzono plik $TARGET_NOTEBOOK z czystego szablonu."
echo "Otwórz go w JupyterLab po lewej stronie i rozpocznij wykonywanie zadań."
echo "Powodzenia w realizacji zadań laboratoryjnych!"
echo "=================================================="
